# Variáveis de ambiente do cadastro online.
#
# Copie para `.env` e preencha. O `.env` está no .gitignore e nunca é
# versionado — este arquivo existe só para dizer o que precisa existir.
#
#     cp .env.example .env
#     node --env-file=.env scripts/servidor-local.ts

# ---------------------------------------------------------------------
# Supabase — o banco deste sistema (e do Presença, que é o mesmo)
# ---------------------------------------------------------------------
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública, que vai para o navegador.
SUPABASE_PUBLISHABLE_KEY=
# ⚠️ Ignora RLS por completo. Só no servidor, nunca no navegador.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://SEU-PROJETO.supabase.co/auth/v1/.well-known/jwks.json

# Conexão direta com o Postgres, para rodar migrações (`scripts/db.ts`).
# Painel → Settings → Database → Connection string → URI.
# ⚠️ É o superusuário do banco.
DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# Personal Access Token da conta, só para publicar Edge Functions e definir
# secrets pela CLI. Credencial diferente das de cima: estas alcançam os
# dados, esta alcança a configuração do projeto.
# Gere em: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------
# Secrets das Edge Functions
#
# Estes não vão no `.env`: são definidos no projeto, com
#     npx supabase secrets set NOME=valor --project-ref SEU-REF
# A lista está aqui porque uma função que sobe sem eles só descobre isso
# na primeira chamada, em produção.
#
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY  (automáticos)
#   SPONTE_KEY, SPONTE_CODIGO_CLIENTE
#   ORIGENS_PERMITIDAS  — domínios que podem chamar as funções, separados
#                         por vírgula. Sem ele, o CORS recusa TODO navegador.
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# Sponte — o ERP da escola, via WSAPIEdu (SOAP)
# ---------------------------------------------------------------------
SPONTE_KEY=
SPONTE_CODIGO_CLIENTE=

# ⚠️ Com `true`, as gravações vão para o Sponte DE VERDADE. A API não tem
# operação de exclusão: o que for criado só sai pela interface deles.
SPONTE_ESCRITA=false
# Com `true`, os registros criados recebem o prefixo "TESTE-SISTEMA".
SPONTE_MODO_TESTE=true

# Usuário da interface web do Sponte, usado só para gerar o link de
# pagamento — a única etapa do fluxo que não tem API.
SPONTE_WEB_LOGIN=
SPONTE_WEB_SENHA=

# ---------------------------------------------------------------------
# LeagueInvest — plataforma de conteúdo (Supabase de terceiros)
#
# Sem estas quatro, o sistema ativa o aluno só no Presença e avisa na tela
# o que ficou pendente, em vez de recusar a ativação inteira.
# ---------------------------------------------------------------------
LEAGUE_URL=https://OUTRO-PROJETO.supabase.co
LEAGUE_ANON_KEY=
# Precisa ser uma conta ADMIN das ligas.
LEAGUE_EMAIL=
LEAGUE_SENHA=

# Senha inicial das contas de aluno criadas por este sistema; o aluno troca
# no primeiro acesso. Não tem padrão no código de propósito — um valor
# chumbado aqui seria a senha inicial de toda conta, à vista de qualquer um
# que lesse o repositório. Sem esta variável, a criação de aluno no
# LeagueInvest falha com aviso, em vez de usar uma senha conhecida.
LEAGUE_SENHA_PADRAO_ALUNO=
